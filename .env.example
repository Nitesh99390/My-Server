# ============ AudioBook Pro - Telegram master bot (bot.py) on your VPS ============
# Copy to .env next to bot.py.  bot.py loads it automatically.

# --- required ---
API_ID=123456                       # https://my.telegram.org
API_HASH=your_api_hash
BOT_TOKEN=123456:ABC-your-bot-token # @BotFather
OWNER_ID=123456789                  # your numeric Telegram user id

# --- Cloudflare Worker(s) that do the synthesis (worker/ in this repo) ---
# Optional here: you can also add/remove them any time from Telegram (🛠 Admin -> Workers -> ➕ Add).
TTS_SERVERS=https://edge-tts-worker.your-account.workers.dev
# OPTIONAL.  Leave empty unless you ran `wrangler secret put API_KEY` on the Worker -
# then put the same value here.  Without a key on both sides everything works as-is.
TTS_API_KEY=

# --- optional ---
CONTACT_USERNAME=Niteshbhumihar
REMOTE_CHUNK_SIZE=3000          # chars per request (clamped to the Worker's MAX_TEXT_LENGTH)
PER_SERVER_CONCURRENCY=4        # starting parallel requests per Worker
PER_SERVER_MAX_CONCURRENCY=8    # ceiling (also clamped to the Worker's /health max_concurrency)
MAX_TOTAL_CONCURRENCY=64
MAX_PARALLEL_JOBS=1
MAX_QUEUED_JOBS=20
CHUNK_TIMEOUT=150               # seconds per request (Worker SYNTH_TIMEOUT is 110)
QUARANTINE_STEPS=60,120,300,600 # bench a throttled Worker for 1m -> 2m -> 5m -> 10m
QUARANTINE_FORGIVE_AFTER=25
MAX_FILE_MB=200
JOBS_DIR=jobs                   # chunk checkpoints (resume after restart)
DB_PATH=bot_database.db
LOG_LEVEL=INFO
PROGRESS_EDIT_INTERVAL=4
RESUME_ON_START=true
