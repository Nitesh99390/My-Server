# =========================== Telegram bot (bot.py) ===========================
API_ID=123456
API_HASH=your_api_hash_from_my.telegram.org
BOT_TOKEN=123456:ABC-your-bot-token
OWNER_ID=123456789
CONTACT_USERNAME=Niteshbhumihar

# ---- Built-in FREE Edge-TTS engine (default, no API key / no render server needed) ----
# The bot talks to Microsoft's free Edge endpoint directly. It runs several chunks
# in parallel for speed but stays under the per-IP limit and auto-slows on throttling.
LOCAL_TTS_ENABLED=true
LOCAL_TTS_CONCURRENCY=4        # parallel streams to start with
LOCAL_TTS_MAX_CONCURRENCY=6    # hard ceiling (auto-scales up while healthy; keep <= 6)
LOCAL_TTS_CHUNK_SIZE=3000      # characters per Edge-TTS request
LOCAL_TTS_MAX_BYTES=3900       # wire bytes per request (Edge limit ~4096) -> 1 chunk = 1 connection
LOCAL_TTS_RETRIES=4
LOCAL_TTS_MIN_GAP_MS=150       # spacing between new connections
LOCAL_TTS_GROW_AFTER=8         # clean chunks before adding one more parallel stream
PROGRESS_EDIT_INTERVAL=4       # seconds between Telegram progress edits

# ---- Optional external render servers (app.py) - extra IPs for even more speed ----
# Shared secret sent to render servers as X-API-Key. It MUST equal API_KEY on every
# render server, otherwise the servers answer HTTP 401 and the bot reports
# "Chunk 1 failed on all attempted servers".  Leave BOTH empty if you do not want auth.
# (If TTS_API_KEY is empty the bot also falls back to API_KEY below.)
TTS_API_KEY=

CHUNK_SIZE=3000
PER_SERVER_CONCURRENCY=4       # starting parallel requests per render server
PER_SERVER_MAX_CONCURRENCY=8   # ceiling per server (auto-clamped to the max_concurrency the server reports on /health)
REMOTE_GROW_AFTER=3            # clean chunks before a render server gets one more parallel slot
REMOTE_MIN_GAP_MS=30           # spacing between new requests to one server (the server paces Edge itself)
PIPELINE_WINDOW_EXTRA=8        # chunks buffered ahead of the in-order writer (keeps slots busy behind a slow chunk)
MAX_TOTAL_CONCURRENCY=64       # hard cap across ALL engines (raise if you run 15+ servers)
MAX_PARALLEL_JOBS=1
MAX_QUEUED_JOBS=20

# ---- Never-give-up job engine (v4) - any file size, any number of servers ----
MAX_FILE_MB=200                # Telegram document size limit accepted by the bot
MAX_EXTRACTED_CHARS=50000000   # sanity cap; a 20 MB Hindi EPUB is ~5-10 M chars
JOBS_DIR=jobs                  # checkpoints: <job>/plan.jsonl + chunks/NNNNNN.mp3 (put on a persistent disk)
JOB_MAX_STALL_MINUTES=0        # 0 = wait forever for throttled engines (only /cancel stops the job)
RESUME_ON_START=true           # continue interrupted jobs automatically after a restart
DB_PATH=bot_database.db
SESSION_NAME=audiobook_pro_bot
LOG_LEVEL=INFO

# ======================= Edge-TTS render server (app.py) =====================
PORT=10000
API_KEY=
MAX_TEXT_LENGTH=6000
MAX_CONCURRENCY=4              # keep <= 6 per IP or Microsoft throttles
MIN_START_GAP_MS=200
DEFAULT_VOICE=hi-IN-MadhurNeural
TTS_RETRIES=3
RATE_LIMIT=120
CACHE_MAX_MB=64
SYNTH_TIMEOUT=240
ATTEMPT_TIMEOUT=75             # per Edge-TTS connection attempt (retries no longer share one budget)
QUEUE_TIMEOUT=45               # wait for a free slot, then 503 + Retry-After so the bot uses another server
MAX_QUEUE=16                   # requests allowed to wait for a slot
TRUST_PROXY_HOPS=0
ENABLE_CORS=true
