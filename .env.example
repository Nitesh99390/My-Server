# ============ AudioBook Pro - Telegram master bot (bot.py) on your VPS ============
# Copy to .env next to bot.py.  bot.py loads it automatically.

# --- required ---
API_ID=123456                       # https://my.telegram.org
API_HASH=your_api_hash
BOT_TOKEN=123456:ABC-your-bot-token # @BotFather
OWNER_ID=123456789                  # your numeric Telegram user id

# --- Cloudflare Worker(s) that do the synthesis (worker/ in this repo) ---
# Optional here: you can also add/remove them any time from Telegram (🛠 Admin -> Workers -> ➕ Add).
TTS_SERVERS=https://edge-tts-worker.your-account.workers.dev
# OPTIONAL.  Leave empty unless you ran `wrangler secret put API_KEY` on the Worker -
# then put the same value here.  Without a key on both sides everything works as-is.
TTS_API_KEY=

# --- optional: fleet tuning (defaults are made for MANY Workers, e.g. 100+) ---
# Microsoft rate-limits per egress (= per Worker).  Keep every Worker's load LOW
# and get speed from the NUMBER of Workers: 100 Workers x 2 requests = 200
# parallel chunks and not a single Worker looks suspicious to Microsoft.
CONTACT_USERNAME=Niteshbhumihar
REMOTE_CHUNK_SIZE=2000          # chars per request (~2 websocket pieces for Hindi); clamped to Worker MAX_TEXT_LENGTH
PER_SERVER_CONCURRENCY=2        # starting parallel requests per Worker
PER_SERVER_MAX_CONCURRENCY=3    # ceiling (also clamped to the Worker's /health max_concurrency)
REMOTE_MIN_GAP_MS=250           # minimum gap between two request starts on the same Worker
MAX_TOTAL_CONCURRENCY=160       # across the whole fleet (raise with more Workers, e.g. 300 for 150 Workers)
HEALTH_PARALLELISM=24           # /health + /tts probes run at once when testing / adding the fleet
MAX_PARALLEL_JOBS=1
MAX_QUEUED_JOBS=20
CHUNK_TIMEOUT=150               # seconds per request (Worker SYNTH_TIMEOUT is 110)
# Only a REAL Microsoft rate limit (403/429 -> Worker answers 503 kind=throttle) benches a
# Worker: 30s -> 1m -> 2m -> 4m.  Timeouts / resets / empty audio are "soft" failures and
# only bench after SOFT_FAIL_LIMIT of them within SOFT_FAIL_WINDOW seconds.
QUARANTINE_STEPS=30,60,120,240
QUARANTINE_FORGIVE_AFTER=8      # clean chunks that lower the bench level by one
QUARANTINE_DECAY_SECS=300       # ... and every 5 quiet minutes lower it by one as well
SOFT_FAIL_LIMIT=4
SOFT_FAIL_WINDOW=120
MAX_FILE_MB=200
JOBS_DIR=jobs                   # chunk checkpoints (resume after restart)
DB_PATH=bot_database.db
LOG_LEVEL=INFO
PROGRESS_EDIT_INTERVAL=4
RESUME_ON_START=true
