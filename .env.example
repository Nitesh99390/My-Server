# =========================== Telegram bot (bot.py) ===========================
API_ID=123456
API_HASH=your_api_hash_from_my.telegram.org
BOT_TOKEN=123456:ABC-your-bot-token
OWNER_ID=123456789
CONTACT_USERNAME=Niteshbhumihar

# ---- Built-in FREE Edge-TTS engine (default, no API key / no render server needed) ----
# The bot talks to Microsoft's free Edge endpoint directly. It runs several chunks
# in parallel for speed but stays under the per-IP limit and auto-slows on throttling.
LOCAL_TTS_ENABLED=true
LOCAL_TTS_CONCURRENCY=3        # parallel streams to start with
LOCAL_TTS_MAX_CONCURRENCY=5    # hard ceiling (auto-scales up while healthy; keep <= 6)
LOCAL_TTS_CHUNK_SIZE=2500      # characters per Edge-TTS request
LOCAL_TTS_RETRIES=4
LOCAL_TTS_MIN_GAP_MS=250       # spacing between new connections

# ---- Optional external render servers (app.py) - extra IPs for even more speed ----
# Shared secret sent to render servers as X-API-Key. It MUST equal API_KEY on every
# render server, otherwise the servers answer HTTP 401 and the bot reports
# "Chunk 1 failed on all attempted servers".  Leave BOTH empty if you do not want auth.
# (If TTS_API_KEY is empty the bot also falls back to API_KEY below.)
TTS_API_KEY=

CHUNK_SIZE=3000
PER_SERVER_CONCURRENCY=4
MAX_PARALLEL_JOBS=1
MAX_QUEUED_JOBS=20
DB_PATH=bot_database.db
SESSION_NAME=audiobook_pro_bot
LOG_LEVEL=INFO

# ======================= Edge-TTS render server (app.py) =====================
PORT=10000
API_KEY=
MAX_TEXT_LENGTH=6000
MAX_CONCURRENCY=4              # keep <= 6 per IP or Microsoft throttles
MIN_START_GAP_MS=200
DEFAULT_VOICE=hi-IN-MadhurNeural
TTS_RETRIES=3
RATE_LIMIT=120
CACHE_MAX_MB=64
SYNTH_TIMEOUT=180
TRUST_PROXY_HOPS=0
ENABLE_CORS=true
